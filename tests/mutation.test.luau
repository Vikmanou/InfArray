--!strict

local test = require('@std/test')
local InfArray = require('../InfArray')

test.case('PushBack appends to an empty array', function(asserts)
	local arr = InfArray.new()
	arr:PushBack(10)
	arr:PushBack(20)
	asserts.eq(arr:Length(), 2)
	asserts.eq(arr:Count(), 2)
	asserts.eq(arr:Get(1), 10)
	asserts.eq(arr:Get(2), 20)
end)

test.case('PushBack returns the global index it landed at', function(asserts)
	local arr = InfArray.new(3, 0)
	asserts.eq(arr:PushBack(7), 4)
	asserts.eq(arr:PushBack(8), 5)
end)

test.case('PushBack continues after a sized constructor', function(asserts)
	local arr = InfArray.new(3, 0)
	arr:PushBack(99)
	asserts.eq(arr:Length(), 4)
	asserts.eq(arr:Count(), 4)
	asserts.eq(arr:Get(4), 99)
end)

test.case('RemoveIndex leaves a hole: count drops, length is unchanged', function(asserts)
	local arr = InfArray.new()
	arr:PushBack(1)
	arr:PushBack(2)
	arr:PushBack(3)
	arr:RemoveIndex(2)
	asserts.eq(arr:Get(2), nil)
	asserts.eq(arr:Count(), 2)
	asserts.eq(arr:Length(), 3)
end)

test.case('RemoveIndex on an absent chunk is a no-op', function(asserts)
	local arr = InfArray.new()
	arr:RemoveIndex(50)
	asserts.eq(arr:Count(), 0)
	asserts.eq(arr:Length(), 0)
end)

test.case('RemoveIndex on an already-empty slot decrements only once', function(asserts)
	local arr = InfArray.new()
	arr:PushBack(1)
	arr:PushBack(2)
	arr:RemoveIndex(1)
	arr:RemoveIndex(1)
	asserts.eq(arr:Count(), 1)
end)
